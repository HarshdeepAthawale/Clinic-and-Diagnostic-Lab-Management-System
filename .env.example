# Backend (Spring Boot). Not needed for local dev with docker-compose — the "dev" profile has defaults.
# For Supabase use the direct or session-pooler connection (not the transaction pooler on port 6543).
DATABASE_URL=jdbc:postgresql://localhost:5432/cdlms
DATABASE_USERNAME=cdlms
DATABASE_PASSWORD=cdlms
# At least 32 random bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=
SPRING_PROFILES_ACTIVE=dev
